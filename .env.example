# Neon Auth
# Enable Auth in the Neon Console, then copy the branch Auth URL here.
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=

# Neon PostgreSQL — server-side only, never use VITE_ prefix
DATABASE_URL=

# Internal service auth
# Must match mealtrack_backend AFFILIATE_INTERNAL_SECRET for local webhook tests.
AFFILIATE_INTERNAL_SECRET=

# Admin session auth
AFFILIATE_ADMIN_SECRET=
